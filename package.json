{
  "name": "opencode-codearts-provider",
  "version": "0.1.0",
  "description": "OpenCode provider plugin for Huawei Cloud CodeArts (snap-access InferHub API, SDK-HMAC-SHA256 signed)",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    "./server": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codearts",
    "huawei",
    "provider"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "zod": "^4.1.8"
  }
}
